# Rust build output
/target/
# wasm app crates build into their own (detached) target dirs
wasm-apps/*/target/
# compiled wasm artifacts (generated by kernel/build.rs into OUT_DIR)
wasm-apps/**/*.wasm

# Generated bootable images
*.img

# Screenshots / captures
*.png
# ...but keep the brand source icon and documentation images
!assets/osjeff-icon.png
!docs/img/*.png

# Editor / OS cruft
*.swp
.DS_Store

# Runtime artifacts
qemu-err.txt
qlog.txt
*.pcap
.shots/

# Claude Code local session state / memory
.claude/
