# Tokens for the shell fuzz target: keywords, operators and quoting.
kw_if="if "
kw_then="; then "
kw_elif="; elif "
kw_else="; else "
kw_fi="; fi"
kw_for="for x in "
kw_while="while "
kw_until="until "
kw_do="; do "
kw_done="; done"
kw_func="f() { "
kw_function="function g { "
kw_close_brace="; }"
kw_brace="{ "
op_pipe=" | "
op_and=" && "
op_or=" || "
op_semi="; "
op_amp=" &"
op_out=" > "
op_append=" >> "
op_in=" < "
op_heredoc=" <<EOF"
op_fd=" 2>&1"
q_single="'"
q_double="\""
q_back="\\"
v_plain="$X"
v_brace="${X}"
v_status="$?"
v_count="$#"
v_at="$@"
v_star="$*"
v_pos="$1"
sub_cmd="$("
sub_arith="$(("
sub_close="))"
glob_star="*"
glob_q="?"
glob_ext="*.txt"
tilde="~/"
comment=" # "
assign="X=1 "
cmd_echo="echo "
cmd_cat="cat "
cmd_ls="ls -la "
cmd_cd="cd .."
cmd_rm="rm -rf "
cmd_grep="grep -i "
cmd_sort="sort -n "
cmd_test="[ -f a.txt ] "
cmd_yes="yes "
cmd_seq="seq 1 100 "
cmd_exit="exit 1"
cmd_return="return 2"
cmd_break="break 2"
cmd_source="source /bin/tool.sh"
cmd_alias="alias e='echo hi'"
cmd_export="export Y=2"
nul="\x00"
nl="\x0a"
